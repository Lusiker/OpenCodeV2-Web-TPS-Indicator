{
  "name": "tps-meter",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "build": "npm run build:gui && npm run build:web",
    "build:gui": "vite build",
    "build:web": "node scripts/build-web.mjs",
