    "watch": "vite build --watch"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.0",
    "solid-js": "1.9.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-solid": "2.11.10"
  }
}
